DATABASE_URL=postgresql://career_app:career_local@127.0.0.1:5432/career_recommendation?schema=public
CLIENT_URL=http://localhost:5173
PORT=3000
JWT_SECRET=
# Keep 0 for a direct connection. For Render, verify the proxy path before setting the hop count.
TRUST_PROXY_HOPS=0

# Set both to enable password recovery. Use a sender on your verified domain.
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Required when running the seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
